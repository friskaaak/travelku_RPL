:root {
  --tk-primary: #155EEF;
  --tk-primary-hover: #1247B8;
  --tk-bg: #F6F8FC;
  --tk-surface: #FFFFFF;
  --tk-heading: #101828;
  --tk-body: #475467;
  --tk-border: #EAECF0;
  --tk-success: #067647;
  --tk-warning: #B54708;
  --tk-error: #B42318;
  --tk-radius: 14px;
  --tk-shadow: 0 1px 2px rgba(16,24,40,.06), 0 4px 16px rgba(16,24,40,.06);
}

body { background: var(--tk-bg); color: var(--tk-body); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
h1, h2, h3, h4, h5, h6 { color: var(--tk-heading); font-weight: 700; }
a { color: var(--tk-primary); }
a:hover { color: var(--tk-primary-hover); }

.btn-primary { --bs-btn-bg: var(--tk-primary); --bs-btn-border-color: var(--tk-primary);
  --bs-btn-hover-bg: var(--tk-primary-hover); --bs-btn-hover-border-color: var(--tk-primary-hover);
  --bs-btn-active-bg: var(--tk-primary-hover); --bs-btn-active-border-color: var(--tk-primary-hover); }
.btn-outline-primary { --bs-btn-color: var(--tk-primary); --bs-btn-border-color: var(--tk-primary);
  --bs-btn-hover-bg: var(--tk-primary); --bs-btn-hover-border-color: var(--tk-primary); }
.btn { border-radius: 10px; font-weight: 600; }

.form-control, .form-select { border-color: var(--tk-border); border-radius: 10px; padding: .65rem .85rem; }
.form-label { color: var(--tk-heading); font-weight: 600; font-size: .9rem; }
:focus-visible { outline: 3px solid rgba(21,94,239,.45); outline-offset: 2px; }
.form-control:focus, .form-select:focus { border-color: var(--tk-primary); box-shadow: 0 0 0 .25rem rgba(21,94,239,.18); }

.tk-card { background: var(--tk-surface); border: 1px solid var(--tk-border); border-radius: var(--tk-radius); box-shadow: var(--tk-shadow); }

.tk-nav { background: var(--tk-surface); border-bottom: 1px solid var(--tk-border); }
.tk-brand { font-weight: 800; color: var(--tk-heading) !important; letter-spacing: -.02em; }
.tk-brand i { color: var(--tk-primary); }
.tk-nav .nav-link { color: var(--tk-body); font-weight: 600; border-radius: 8px; }
.tk-nav .nav-link:hover, .tk-nav .nav-link.active { color: var(--tk-primary); background: #EFF4FF; }

.tk-hero { background: linear-gradient(135deg, #0B2F7A 0%, #155EEF 60%, #53B1FD 100%); color: #fff; padding: 4rem 0 7rem; }
.tk-hero h1 { color: #fff; font-size: clamp(1.9rem, 4vw, 3rem); }
.tk-hero p { color: rgba(255,255,255,.88); }
.tk-search { margin-top: -5rem; padding: 1.5rem; }
.tk-search .nav-pills .nav-link { color: var(--tk-body); font-weight: 700; border-radius: 10px; }
.tk-search .nav-pills .nav-link.active { background: var(--tk-primary); color: #fff; }

.tk-banner { border-radius: var(--tk-radius); color: #fff; padding: 1.5rem; min-height: 190px; position: relative; overflow: hidden;
  background: linear-gradient(135deg, #155EEF, #7A5AF8); display: flex; flex-direction: column; justify-content: flex-end; }
.tk-banner h3 { color: #fff; }
.tk-badge { position: absolute; top: 1rem; left: 1rem; background: #fff; color: var(--tk-primary); font-weight: 700; font-size: .75rem; padding: .25rem .6rem; border-radius: 999px; }

.tk-dest { border-radius: var(--tk-radius); color: #fff; padding: 1.25rem; min-height: 170px; display: flex; flex-direction: column; justify-content: flex-end; text-decoration: none; transition: transform .15s; }
.tk-dest:hover { transform: translateY(-3px); color: #fff; }
.tk-dest i { font-size: 1.6rem; margin-bottom: auto; }
.tk-dest h5 { color: #fff; margin: 0; }

.tk-feature i { font-size: 1.6rem; color: var(--tk-primary); }
.tk-empty { border: 1px dashed var(--tk-border); border-radius: var(--tk-radius); padding: 2rem; text-align: center; background: var(--tk-surface); }
.tk-footer { background: var(--tk-heading); color: #98A2B3; }
.tk-footer a { color: #D0D5DD; text-decoration: none; }
.tk-auth { max-width: 460px; margin: 3rem auto; padding: 2rem; }
.tk-demo-note { background: #FFFAEB; border: 1px solid #FEDF89; color: var(--tk-warning); border-radius: 10px; font-size: .85rem; padding: .6rem .85rem; }

@media (max-width: 1024px) { .tk-hero { padding: 3rem 0 6rem; } }
@media (max-width: 576px) { .tk-search { padding: 1rem; } .tk-auth { margin: 1.5rem 1rem; padding: 1.5rem; } }

/* ---------- Peta kursi ---------- */
.tk-seatmap { display: inline-block; min-width: 280px; padding: .5rem 1rem 1rem; background: var(--tk-bg); border: 1px solid var(--tk-border); border-radius: var(--tk-radius); }
.tk-seat-class { text-align: center; font-weight: 700; color: var(--tk-heading); font-size: .85rem; margin: .75rem 0 .35rem; }
.tk-seat-row { display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 6px; }
.tk-seat-rownum { width: 24px; text-align: center; font-size: .75rem; color: var(--tk-body); }
.tk-seat-aisle { width: 22px; }

.tk-seat { width: 34px; height: 34px; padding: 0; border-radius: 9px 9px 4px 4px; border: 1px solid #ABEFC6; background: #ECFDF3; color: var(--tk-success); font-size: .75rem; font-weight: 700; line-height: 1; }
.tk-seat:hover:not(:disabled) { border-color: var(--tk-primary); box-shadow: 0 0 0 2px rgba(21,94,239,.25); }
.tk-seat.is-selected, .tk-seat[data-state="mine"] { background: var(--tk-primary); border-color: var(--tk-primary-hover); color: #fff; }
.tk-seat[data-state="held"] { background: #FFFAEB; border: 1px dashed var(--tk-warning); color: var(--tk-warning); cursor: not-allowed; }
.tk-seat[data-state="confirmed"] { background: #EAECF0; border-color: #D0D5DD; color: #667085; text-decoration: line-through; cursor: not-allowed; }
.tk-seat-sample { display: inline-block; width: 20px; height: 20px; vertical-align: middle; border-radius: 6px 6px 3px 3px; }
@media (max-width: 576px) { .tk-seat { width: 30px; height: 30px; } }

/* ---------- Panel admin ---------- */
.tk-sidenav .nav-link { color: var(--tk-body); font-weight: 600; border-radius: 8px; }
.tk-sidenav .nav-link:hover, .tk-sidenav .nav-link.active { color: var(--tk-primary); background: #EFF4FF; }
.tk-table th { font-size: .8rem; color: var(--tk-body); font-weight: 600; white-space: nowrap; }

/* ---------- Pembayaran ---------- */
.tk-method { display: flex; align-items: center; gap: .6rem; padding: .7rem .85rem; border: 1px solid var(--tk-border); border-radius: 10px; background: var(--tk-surface); cursor: pointer; margin: 0; }
.tk-method:hover { border-color: var(--tk-primary); }
.tk-method:has(input:checked) { border-color: var(--tk-primary); background: #EFF4FF; box-shadow: 0 0 0 2px rgba(21,94,239,.15); }
.tk-method input { flex-shrink: 0; margin: 0; }
.tk-paycode { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 1.5rem; font-weight: 700; letter-spacing: .06em; color: var(--tk-heading); word-break: break-all; }
/* ---------- Receipt dan tiket ---------- */
.tk-doc-head { border-bottom: 2px solid var(--tk-primary); padding-bottom: .75rem; margin-bottom: 1rem; }
.tk-dl dt { color: var(--tk-body); font-weight: 600; font-size: .85rem; }
.tk-dl dd { color: var(--tk-heading); margin-bottom: .6rem; }
.tk-ticket { overflow: hidden; }
.tk-ticket-band { padding: .75rem 1.25rem; color: #fff; display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.tk-ticket-band.is-flight { background: #155EEF; }
.tk-ticket-band.is-train { background: #067647; }
.tk-ticket-band.is-voucher { background: #B54708; }
.tk-ticket-qr { background: #fff; padding: 8px; border: 1px solid var(--tk-border); border-radius: 10px; display: inline-block; line-height: 0; }
.tk-ticket-qr svg { width: 160px; height: 160px; }
.tk-code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .72rem; word-break: break-all; }

@media print {
  .no-print, .tk-nav, .tk-footer, .alert, .bg-warning-subtle { display: none !important; }
  body { background: #fff !important; }
  .tk-card { box-shadow: none !important; }
  .container { max-width: 100% !important; }
  .tk-ticket, .tk-receipt { break-inside: avoid; }
}

/* ---------- UI-2: hasil pencarian, laci filter, linimasa ---------- */
.offcanvas { background: var(--surface-card); color: var(--text-secondary); border-color: var(--border-subtle); }
.offcanvas-header { border-bottom: 1px solid var(--border-subtle); }
.offcanvas-lg { --bs-offcanvas-width: 330px; }
.tk-filter-box { padding: 1rem; width: 100%; }
@media (min-width: 992px) {
  .tk-filter-box { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
}
.tk-result { transition: border-color .15s, transform .15s; }
.tk-result:hover { border-color: var(--accent-primary); }

.tk-trip { display: flex; align-items: center; gap: .75rem; }
.tk-trip-end { min-width: 64px; }
.tk-trip-end.is-arr { text-align: right; }
.tk-time { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 1.4rem; font-weight: 700; color: var(--text-primary); line-height: 1.1; }
.tk-trip-line { flex: 1; text-align: center; font-size: .75rem; color: var(--text-muted); min-width: 70px; }
.tk-trip-line .bar { position: relative; height: 2px; background: var(--border-input); margin: .45rem 7px; border-radius: 2px; }
.tk-trip-line .bar::before, .tk-trip-line .bar::after { content: ""; position: absolute; top: 50%; width: 10px; height: 10px; border-radius: 50%; transform: translateY(-50%); }
.tk-trip-line .bar::before { left: -7px; background: var(--accent-primary); }
.tk-trip-line .bar::after { right: -7px; background: var(--surface-card); border: 2px solid var(--accent-primary); }
@media (max-width: 576px) { .tk-time { font-size: 1.15rem; } .tk-trip-end { min-width: 52px; } }